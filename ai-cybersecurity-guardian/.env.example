# ============================================================
# AI Personal Cybersecurity Guardian — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.
# ============================================================

# ---- Application ----
ENVIRONMENT=development
# Options: development | test | staging | production

# ---- Database ----
POSTGRES_DB=cyberguardian
POSTGRES_USER=cyberguardian
POSTGRES_PASSWORD=change-me-in-dot-env

DATABASE_URL=postgresql+psycopg://cyberguardian:change-me-in-dot-env@localhost:5432/cyberguardian

# ---- JWT (used from M1 onwards) ----
# Must be at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173
